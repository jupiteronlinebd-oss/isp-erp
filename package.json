{
  "name": "isp-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create isp-erp-db",
    "db:migrate": "wrangler d1 execute isp-erp-db --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute isp-erp-db --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute isp-erp-db --remote --file=./seed.sql",
    "db:seed:local": "wrangler d1 execute isp-erp-db --local --file=./seed.sql",
    "typegen": "wrangler types"
  },
  "dependencies": {
    "@react-router/node": "^7.2.0",
    "@react-router/serve": "^7.2.0",
    "isbot": "^5.1.17",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@react-router/dev": "^7.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
